; indents.scm — Indentation rules for Hew

[
  (block)
  (struct_declaration)
  (tuple_type_declaration)
  (enum_declaration)
  (trait_declaration)
  (impl_declaration)
  (actor_declaration)
  (supervisor_declaration)
  (machine_declaration)
  (extern_block)
  (match_expression)
  (select_expression)
  (join_expression)
  (if_expression)
  (for_statement)
  (while_statement)
  (loop_statement)
  (lambda)
] @indent

[
  "}"
  "]"
  ")"
] @outdent
